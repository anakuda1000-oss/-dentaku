        "import re\n",
        "from collections import Counter\n",
        "\n",
        "def analyze_text_structure(text):\n",
        "    print(\"========================================\")\n",
        "    print(\"       文章構造の解析レポート\")\n",
        "    print(\"========================================\\n\")\n",
        "\n",
        "    # 1. 全体量の把握\n",
        "    total_chars = len(text)\n",
        "    # 改行で分割して段落数をカウント（空行を除く）\n",
        "    paragraphs = [p for p in text.split('\\n') if p.strip()]\n",
        "    total_paragraphs = len(paragraphs)\n",
        "\n",
        "    # 「。」や「！」などで文を分割して文の数をカウント\n",
        "    sentences = [s for s in re.split(r'[。！？\\n]', text) if s.strip()]\n",
        "    total_sentences = len(sentences)\n",
        "\n",
        "    # 平均の文の長さを計算\n",
        "    avg_sentence_len = total_chars / total_sentences if total_sentences > 0 else 0\n",
        "\n",
        "    print(\"【1. 文章の全体ボリューム】\")\n",
        "    print(f\"- 総文字数    : {total_chars} 文字\")\n",
        "    print(f\"- 段落数      : {total_paragraphs} 個\")\n",
        "    print(f\"- 文の数      : {total_sentences} 文\")\n",
        "    print(f\"- 1文あたりの平均長 : {avg_sentence_len:.1f} 文字\")\n",
        "\n",
        "    # 読みやすさの判定\n",
        "    if avg_sentence_len > 60:\n",
        "        print(\"  ※ 1文が長めです。箇条書きや「。」で区切るとさらに読みやすくなります。\")\n",
        "    else:\n",
        "        print(\"  ※ 適切な文の長さで読みやすい構成です。\")\n",
        "    print(\"\\n\" + \"-\"*40 + \"\\n\")\n",
        "\n",
        "    # 2. 頻出キーワードの抽出（簡易形態素解析風）\n",
        "    # 2文字以上の日本語単語っぽいものを抽出する正規表現\n",
        "    words = re.findall(r'[一-龥ぁ-んァ-ヶー]{2,}', text)\n",
        "\n",
        "    # 一般的な助詞や接続詞などの除外リスト（ストップワード）\n",
        "    stopwords = {'です', 'ます', 'こと', 'ため', 'よう', 'これ', 'それ', 'あれ', 'から', 'ので', 'また', 'しかし'}\n",
        "    filtered_words = [w for w in words if w not in stopwords]\n",
        "\n",
        "    # 単語の出現回数をカウント\n",
        "    word_counts = Counter(filtered_words)\n",
        "    top_words = word_counts.most_common(5)\n",
        "\n",
        "    print(\"【2. 重要キーワード Top 5】\")\n",
        "    if top_words:\n",
        "        for rank, (word, count) in enumerate(top_words, 1):\n",
        "            print(f\" {rank}位: {word} ({count}回出現)\")\n",
        "    else:\n",
        "        print(\" 十分な長さのキーワードが見つかりませんでした。\")\n",
        "\n",
        "    print(\"\\n\" + \"-\"*40 + \"\\n\")\n",
        "\n",
        "    # 3. 段落ごとの構造マップ（プレビュー）\n",
        "    print(\"【3. 段落構造マップ】\")\n",
        "    for i, p in enumerate(paragraphs, 1):\n",
        "        first_sentence = re.split(r'[。！？]', p)[0]\n",
        "        preview = first_sentence[:25] + \"...\" if len(first_sentence) > 25 else first_sentence\n",
        "        print(f\"段落 {i} [{len(p)}文字] -> 書き出し: 「{preview}」\")\n",
        "\n",
        "    print(\"\\n========================================\")\n",
        "\n",
        "# --- 試しに解析するサンプル文章 ---\n",
        "sample_text = \"\"\"\n",
        "Pythonは初心者にとって非常に学びやすいプログラミング言語です。文法がシンプルで読みやすいため、最初に学ぶ言語として世界中で選ばれています。\n",
        "\n",
        "プログラミングを学ぶことで、業務の効率化や自動化が可能になります。たとえば、Excelデータの集計やWebサイトからの情報収集などを自動で行うことができます。\n",
        "\n",
        "さらに、本格的な機械学習やAI開発の分野でもPythonが標準的に使われています。自分のアイデアを形にするための強力なツールとなるでしょう。\n",
        "\"\"\"\n",
        "\n",
        "# プログラムを実行\n",
        "analyze_text_structure(sample_text)"
      ]
